{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cloudoptix.io/schemas/cloudoptix.schema.json",
  "title": "CloudOptix Specification",
  "description": "JSON Schema for cloudoptix.yaml, generated by reading internal/domain/spec/spec.go's Go struct and its `yaml` tags exactly. Property names below follow the yaml tags (the shape of the file a customer actually commits to git), not the json tags (the wire shape internal/domain/spec/spec.go also carries for the API). Spec.Provenance and Spec.OpenQuestions are excluded here because both carry `yaml:\"-\"` in the Go source — they are kept out of the customer-facing YAML file by design (see docs/onboarding-spec.md, SPEC-ONB-002) and are never part of what a customer edits or commits.",
  "type": "object",
  "required": ["apiVersion", "kind", "organization", "application", "aws", "business", "objectives", "optimization", "automation", "governance", "security", "observability", "notifications"],
  "properties": {
    "apiVersion": {
      "type": "string",
      "const": "cloudoptix.io/v1",
      "description": "spec.CurrentAPIVersion. spec.Validate() rejects any other value as unsupported by this build."
    },
    "kind": {
      "type": "string",
      "const": "CloudOptixSpec",
      "description": "spec.KindSpec."
    },
    "organization": { "$ref": "#/$defs/Organization" },
    "application": { "$ref": "#/$defs/Application" },
    "aws": { "$ref": "#/$defs/AWS" },
    "workloads": {
      "type": "array",
      "items": { "$ref": "#/$defs/Workload" }
    },
    "business": { "$ref": "#/$defs/Business" },
    "objectives": { "$ref": "#/$defs/Objectives" },
    "optimization": { "$ref": "#/$defs/Optimization" },
    "automation": { "$ref": "#/$defs/Automation" },
    "governance": { "$ref": "#/$defs/Governance" },
    "security": { "$ref": "#/$defs/Security" },
    "observability": { "$ref": "#/$defs/Observability" },
    "notifications": { "$ref": "#/$defs/Notifications" },
    "teams": {
      "type": "array",
      "items": { "$ref": "#/$defs/Team" }
    }
  },
  "$defs": {
    "Organization": {
      "type": "object",
      "description": "spec.Organization — the tenant's company context.",
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "industry": { "type": "string" },
        "size": { "type": "string" },
        "businessRegions": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Organization.Regions in Go; yaml tag businessRegions."
        },
        "primaryContact": { "type": "string" }
      }
    },
    "Application": {
      "type": "object",
      "description": "spec.Application — the software being optimized.",
      "required": ["name", "architecture"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "domain": { "type": "string" },
        "criticality": { "type": "string", "enum": ["low", "medium", "high", "critical"] },
        "architecture": { "$ref": "#/$defs/ArchitectureProfile" }
      }
    },
    "ArchitectureProfile": {
      "type": "object",
      "description": "spec.ArchitectureProfile — the shape of the system, gathered conversationally and reconciled against discovery.",
      "properties": {
        "style": { "type": "string", "examples": ["microservices", "monolith", "serverless"] },
        "computePlatforms": { "type": "array", "items": { "type": "string" } },
        "databases": { "type": "array", "items": { "type": "string" } },
        "caches": { "type": "array", "items": { "type": "string" } },
        "messaging": { "type": "array", "items": { "type": "string" } },
        "storage": { "type": "array", "items": { "type": "string" } },
        "networking": { "type": "array", "items": { "type": "string" } },
        "observability": { "type": "array", "items": { "type": "string" } },
        "deploymentModel": { "type": "string" },
        "iac": { "type": "array", "items": { "type": "string" } }
      }
    },
    "AWS": {
      "type": "object",
      "description": "spec.AWS — account and region topology.",
      "required": ["accounts", "accessMode"],
      "properties": {
        "accounts": {
          "type": "array",
          "items": { "$ref": "#/$defs/Account" }
        },
        "accessMode": { "type": "string", "const": "assume_role", "description": "cloud.AccessAssumeRole is the only mode spec.Security.AWSAccessMode/AWS.AccessMode support for a real (non-demo) tenant — see docs/security-spec.md, SPEC-SEC-001." },
        "payerAccountId": { "type": "string", "pattern": "^[0-9]{12}$" },
        "organizationId": { "type": "string" },
        "cur": { "$ref": "#/$defs/CURConfig" }
      }
    },
    "Account": {
      "type": "object",
      "description": "spec.Account — one AWS account in scope. Account ID and region formats mirror internal/domain/spec/validate.go's accountRe/regionRe.",
      "required": ["id", "environment", "regions", "production"],
      "properties": {
        "id": { "type": "string", "pattern": "^[0-9]{12}$" },
        "alias": { "type": "string" },
        "environment": { "type": "string", "enum": ["production", "staging", "development", "test", "sandbox", "dr"] },
        "regions": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "pattern": "^[a-z]{2}(-gov)?-[a-z]+-[0-9]$" }
        },
        "roleArn": { "type": "string", "pattern": "^arn:aws[a-z-]*:iam::[0-9]{12}:role/.+$" },
        "externalId": { "type": "string" },
        "production": { "type": "boolean" }
      }
    },
    "CURConfig": {
      "type": "object",
      "description": "spec.CURConfig — locates the Cost & Usage Report.",
      "required": ["bucket"],
      "properties": {
        "bucket": { "type": "string" },
        "prefix": { "type": "string" },
        "region": { "type": "string" },
        "reportName": { "type": "string" }
      }
    },
    "Workload": {
      "type": "object",
      "description": "spec.Workload — a declared workload, seeding attribution before discovery has anything to work with.",
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "type": { "type": "string" },
        "platform": { "type": "string" },
        "environment": { "type": "string" },
        "criticality": { "type": "string" },
        "owner": { "type": "string" },
        "team": { "type": "string" },
        "cluster": { "type": "string" },
        "namespace": { "type": "string" },
        "dependsOn": { "type": "array", "items": { "type": "string" } },
        "tagSelector": { "type": "object", "additionalProperties": { "type": "string" } },
        "slo": { "$ref": "#/$defs/WorkloadSLO" }
      }
    },
    "WorkloadSLO": {
      "type": "object",
      "description": "spec.WorkloadSLO — the per-workload reliability contract.",
      "properties": {
        "availability": { "type": "number", "minimum": 0, "maximum": 1 },
        "latencyP95Ms": { "type": "number", "minimum": 0 },
        "latencyP99Ms": { "type": "number", "minimum": 0 },
        "errorRateMax": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "Business": {
      "type": "object",
      "description": "spec.Business — the commercial context: the denominators that make cost mean something.",
      "properties": {
        "transactions": { "type": "array", "items": { "$ref": "#/$defs/TransactionSpec" } },
        "kpis": { "type": "array", "items": { "$ref": "#/$defs/KPI" } },
        "customerCount": { "type": "integer", "minimum": 0 },
        "peakSeasons": { "type": "array", "items": { "type": "string" } },
        "trafficProfile": { "type": "string" }
      }
    },
    "TransactionSpec": {
      "type": "object",
      "description": "spec.TransactionSpec — declares a business transaction and its volume. This is the object that makes econ.ScopeTransaction and cost-per-transaction Cost SLOs possible — see docs/architecture-economics-spec.md.",
      "required": ["name", "critical"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "monthlyVolume": { "type": "number", "minimum": 0 },
        "workloads": { "type": "array", "items": { "type": "string" } },
        "targetCostPerUnit": { "type": "number", "minimum": 0 },
        "volumeMetric": { "type": "string" },
        "critical": { "type": "boolean" }
      }
    },
    "KPI": {
      "type": "object",
      "description": "spec.KPI — a business metric the tenant tracks alongside cost.",
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "unit": { "type": "string" },
        "target": { "type": "number" }
      }
    },
    "Objectives": {
      "type": "object",
      "description": "spec.Objectives — the measurable goals CloudOptix is being hired to hit.",
      "properties": {
        "costReductionTarget": { "type": "number", "minimum": 0, "maximum": 1 },
        "monthlyBudget": { "type": "number", "minimum": 0 },
        "availabilityTarget": { "type": "number", "minimum": 0, "maximum": 1 },
        "maxLatencyMs": { "type": "number", "minimum": 0 },
        "costSlos": { "type": "array", "items": { "$ref": "#/$defs/CostSLOSpec" } },
        "timeframe": { "type": "string" }
      }
    },
    "CostSLOSpec": {
      "type": "object",
      "description": "spec.CostSLOSpec — declares a cost objective in the specification. Kind mirrors econ.SLOKind; see docs/architecture-economics-spec.md, SPEC-ECON-003.",
      "required": ["name", "kind", "target"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "kind": {
          "type": "string",
          "enum": ["absolute_spend", "cost_per_transaction", "cost_per_request", "cost_per_customer", "waste_ratio", "efficiency_score"]
        },
        "scope": {
          "type": "string",
          "enum": ["organization", "account", "environment", "application", "workload", "business_capability", "api", "transaction", "resource"]
        },
        "target": { "type": "number" },
        "transaction": { "type": "string", "description": "Required when kind is cost_per_transaction — must name an entry in business.transactions[].name." },
        "window": {
          "type": "string",
          "enum": ["calendar_month", "rolling_30d", "rolling_7d", "calendar_quarter"]
        },
        "errorBudgetPct": { "type": "number", "minimum": 0, "maximum": 1 },
        "breachActions": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["notify", "require_approval", "freeze_cost_increases", "generate_recommendations", "open_investigation"]
          }
        }
      }
    },
    "Optimization": {
      "type": "object",
      "description": "spec.Optimization — the tenant's appetite and constraints.",
      "required": ["riskTolerance", "spotAllowed"],
      "properties": {
        "riskTolerance": { "type": "string", "enum": ["low", "medium", "high"] },
        "preferences": { "type": "array", "items": { "type": "string" } },
        "excludedActions": { "type": "array", "items": { "type": "string" } },
        "excludedResources": { "type": "array", "items": { "type": "string" } },
        "excludedTags": { "type": "object", "additionalProperties": { "type": "string" } },
        "spotAllowed": { "type": "boolean" },
        "commitmentAppetite": { "type": "string" },
        "minSavingThreshold": { "type": "number", "minimum": 0 }
      }
    },
    "Automation": {
      "type": "object",
      "description": "spec.Automation — the master control over autonomous change.",
      "required": ["enabled", "autoRollback"],
      "properties": {
        "enabled": { "type": "boolean" },
        "environments": { "type": "array", "items": { "type": "string" } },
        "autoExecuteActions": { "type": "array", "items": { "type": "string" } },
        "maintenanceWindows": { "type": "array", "items": { "$ref": "#/$defs/MaintenanceWindow" } },
        "maxConcurrentChanges": { "type": "integer", "minimum": 0 },
        "maxMonthlyImpact": { "type": "number", "minimum": 0 },
        "validationWindowMinutes": { "type": "integer", "minimum": 0 },
        "autoRollback": { "type": "boolean" }
      }
    },
    "MaintenanceWindow": {
      "type": "object",
      "description": "spec.MaintenanceWindow — a permitted change window in cron-like terms.",
      "required": ["name", "days", "startUtc", "durationMinutes"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "days": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "enum": ["mon", "tue", "wed", "thu", "fri", "sat", "sun"] }
        },
        "startUtc": { "type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$" },
        "durationMinutes": { "type": "integer", "exclusiveMinimum": 0 },
        "environments": { "type": "array", "items": { "type": "string" } }
      }
    },
    "Governance": {
      "type": "object",
      "description": "spec.Governance — the approval and change-management posture.",
      "required": ["productionChangesRequireApproval", "segregationOfDuties"],
      "properties": {
        "productionChangesRequireApproval": { "type": "boolean" },
        "minApprovals": { "type": "integer", "minimum": 0 },
        "approverRoles": { "type": "array", "items": { "type": "string" } },
        "segregationOfDuties": { "type": "boolean" },
        "changeManagementSystem": { "type": "string" },
        "changeFreezeWindows": { "type": "array", "items": { "type": "string" } },
        "policyPack": { "type": "string", "enum": ["conservative", "balanced", "aggressive", "regulated"] }
      }
    },
    "Security": {
      "type": "object",
      "description": "spec.Security — security and compliance posture.",
      "required": ["awsAccessMode", "encryptionRequired"],
      "properties": {
        "awsAccessMode": { "type": "string", "const": "assume_role" },
        "complianceFrameworks": { "type": "array", "items": { "type": "string" } },
        "dataResidency": { "type": "array", "items": { "type": "string" } },
        "encryptionRequired": { "type": "boolean" },
        "ssoProvider": { "type": "string" },
        "auditRetentionDays": { "type": "integer", "minimum": 0 },
        "piiHandling": { "type": "string" }
      }
    },
    "Observability": {
      "type": "object",
      "description": "spec.Observability — the telemetry CloudOptix can read.",
      "required": ["tracingEnabled"],
      "properties": {
        "metricsSources": { "type": "array", "items": { "type": "string" } },
        "prometheusEndpoint": { "type": "string" },
        "otelEndpoint": { "type": "string" },
        "tracingEnabled": { "type": "boolean" },
        "logRetentionDays": { "type": "integer", "minimum": 0 }
      }
    },
    "Notifications": {
      "type": "object",
      "description": "spec.Notifications — the routing configuration.",
      "properties": {
        "channels": { "type": "array", "items": { "$ref": "#/$defs/NotificationChannel" } },
        "subscriptions": {
          "type": "object",
          "additionalProperties": { "type": "array", "items": { "type": "string" } }
        },
        "quietHoursUtc": { "type": "string" }
      }
    },
    "NotificationChannel": {
      "type": "object",
      "description": "spec.NotificationChannel — one delivery target. secretRef is a reference resolved at send time via ports.SecretResolver; it is never itself the secret — see docs/architecture.md, SPEC-ARCH-005.",
      "required": ["name", "type", "target"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "type": { "type": "string", "enum": ["email", "slack", "webhook"] },
        "target": { "type": "string" },
        "secretRef": { "type": "string" },
        "severities": {
          "type": "array",
          "items": { "type": "string", "enum": ["low", "medium", "high", "critical"] }
        }
      }
    },
    "Team": {
      "type": "object",
      "description": "spec.Team — an ownership grouping.",
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "contact": { "type": "string" },
        "owns": { "type": "array", "items": { "type": "string" } },
        "members": { "type": "array", "items": { "$ref": "#/$defs/Member" } }
      }
    },
    "Member": {
      "type": "object",
      "description": "spec.Member — a user with roles.",
      "required": ["email", "roles"],
      "properties": {
        "email": { "type": "string", "pattern": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$" },
        "name": { "type": "string" },
        "roles": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": ["platform_admin", "tenant_admin", "architect", "finops_analyst", "sre", "developer", "auditor", "viewer"]
          }
        }
      }
    }
  }
}
